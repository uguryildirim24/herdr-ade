#!/usr/bin/python3
"""Host controller. Privileged operations have fixed sandbox-only targets."""
import argparse
import os
from pathlib import Path
import pwd
import shlex
import shutil
import socket
import subprocess
import sys
import time

HOME = Path('/home/wall')
BASE = Path('/var/lib/herdr-wall')
UNIT = 'herdr-wall'
PORT = 22285
BOX_PORT = 22286


def run(*args, **kwargs):
    return subprocess.run(list(map(str, args)), check=True, **kwargs)


def ssh(command=None, box=False):
    args = ['ssh', '-F', '/dev/null', '-i', str(BASE / 'client'),
            '-o', 'IdentitiesOnly=yes', '-o', 'StrictHostKeyChecking=yes',
            '-o', f'UserKnownHostsFile={BASE}/known_hosts', '-p',
            str(BOX_PORT if box else PORT), f'{"wallbox" if box else "wall"}@127.0.0.1']
    args += ['-t'] if command is None else [command]
    return run(*args)


def wait_port(port):
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        try:
            with socket.create_connection(('127.0.0.1', port), timeout=0.2):
                return
        except OSError:
            time.sleep(0.05)
    raise RuntimeError(f'sandbox sshd on {port} did not start')


def require_root():
    if os.geteuid() != 0:
        sys.exit('Use sudo tools/wall/wall for the host controller; agents enter over SSH.')


def install(args):
    require_root()
    BASE.mkdir(mode=0o700, parents=True, exist_ok=True)
    for name, home in [('wall', HOME), ('wallbox', HOME / 'box')]:
        try:
            pwd.getpwnam(name)
        except KeyError:
            run('useradd', '--no-create-home', '--home-dir', home, '--shell', '/bin/bash', name)
            # Public-key-only sshd rejects locked accounts. Random password is
            # never retained; password authentication is disabled on both ports.
            run('chpasswd', input=f'{name}:{os.urandom(32).hex()}\n', text=True)
        account = pwd.getpwnam(name)
        if Path(account.pw_dir) != home or account.pw_uid == 0:
            sys.exit(f'{name} already exists with an unsafe identity/home')
        groups = subprocess.check_output(['id', '-nG', name], text=True).split()
        if groups != [name]:
            sys.exit(f'{name} must have only its private group, got {groups}')
    (BASE / 'bin').mkdir(exist_ok=True)
    for name in ['herdr', 'herdr-ade', 'herdr-pi', 'herdr-rundown']:
        source = Path(args.herdr) if name == 'herdr' else Path(args.build) / name
        shutil.copy2(source.resolve(), BASE / 'bin' / name)
        run('strip', BASE / 'bin' / name)
    shutil.copy2(Path(args.node).resolve(), BASE / 'bin/node')
    # Only the npm executable package, never the source account's config/cache.
    npm = Path(args.npm).resolve().parent.parent
    shutil.copytree(npm, BASE / 'npm', dirs_exist_ok=True)
    (BASE / 'empty-npmrc').write_text('')
    env = {'HOME': str(BASE), 'PATH': f'{BASE}/bin:/usr/bin:/bin',
           'NPM_CONFIG_USERCONFIG': '/dev/null', 'NPM_CONFIG_GLOBALCONFIG': str(BASE / 'empty-npmrc')}
    run(BASE / 'bin/node', BASE / 'npm/bin/npm-cli.js', 'install', '--ignore-scripts',
        '--no-audit', '--no-fund', '--prefix', BASE / 'pi',
        '@earendil-works/pi-coding-agent@0.99.1', env=env)
    shutil.copytree(Path(__file__).resolve().parent, BASE / 'tools', dirs_exist_ok=True)
    if not (BASE / 'client').exists():
        run('ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', BASE / 'client')
        run('ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', BASE / 'host')
    for port, user in [(PORT, 'wall'), (BOX_PORT, 'wallbox')]:
        (BASE / f'sshd-{port}').write_text(f'''Port {port}
ListenAddress 127.0.0.1
HostKey {BASE}/host
PidFile /run/herdr-wall-{port}.pid
AuthorizedKeysFile .ssh/authorized_keys
AllowUsers {user}
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PermitRootLogin no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
Subsystem sftp internal-sftp
''')
    pub = (BASE / 'host.pub').read_text().split()
    (BASE / 'known_hosts').write_text(''.join(
        f'[127.0.0.1]:{p} {pub[0]} {pub[1]}\n' for p in [PORT, BOX_PORT]))
    # Each port has its own cgroup: connection loss stops only sshd; reboot
    # kills the box's herdr/ticker/lanes too, not wall's local coordinator.
    for port in [PORT, BOX_PORT]:
        unit = f'{UNIT}-{port}'
        Path(f'/etc/systemd/system/{unit}.service').write_text(f'''[Unit]
Description=Isolated wall sandbox SSH {port}
[Service]
ExecStart=/bin/sh -c 'mkdir -p /run/sshd; exec /usr/sbin/sshd -D -e -f {BASE}/sshd-{port}'
KillMode=control-group
ProtectHome=tmpfs
BindPaths={HOME}
ProtectSystem=strict
ReadWritePaths={HOME}
PrivateDevices=yes
TemporaryFileSystem=/tmp:rw,nosuid,nodev,mode=1777,size=32M /var/tmp:rw,nosuid,nodev,mode=1777,size=32M /dev/shm:rw,nosuid,nodev,mode=1777,size=16M /run:rw,nosuid,nodev,size=16M
BindReadOnlyPaths=/run/systemd/resolve/stub-resolv.conf
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryMax=2G
TasksMax=512
''')
    run('systemctl', 'daemon-reload')
    reset()


def stop():
    for port in [PORT, BOX_PORT]:
        run('systemctl', 'stop', f'{UNIT}-{port}')
    # Cgroups catch descendants, including detached tickers and pane shells.
    for user in ['wall', 'wallbox']:
        subprocess.run(['pkill', '-KILL', '-u', user], check=False)


def reset():
    require_root()
    if not (BASE / 'tools/guest.py').is_file():
        sys.exit('Run install first')
    stop()
    HOME.mkdir(parents=True, exist_ok=True)
    if os.path.ismount(HOME):
        if subprocess.check_output(['findmnt', '-n', '-o', 'FSTYPE', HOME], text=True).strip() != 'tmpfs':
            sys.exit('Refusing to wipe a non-tmpfs /home/wall')
        run('umount', HOME)
    elif any(HOME.iterdir()):
        sys.exit('Refusing to wipe a non-mounted, nonempty /home/wall')
    run('mount', '-t', 'tmpfs', '-o', 'size=2048M,nosuid,nodev,mode=0755', 'herdr-wall', HOME)
    for user, home in [('wall', HOME), ('wallbox', HOME / 'box')]:
        home.mkdir(exist_ok=True)
        (home / '.ssh').mkdir(mode=0o700)
        (home / '.ssh/authorized_keys').write_text((BASE / 'client.pub').read_text())
        (home / 'bin').mkdir()
        for binary in (BASE / 'bin').iterdir():
            shutil.copy2(binary, home / 'bin' / binary.name)
        shutil.copytree(BASE / 'tools', home / 'tools')
        shutil.copytree(BASE / 'pi', home / 'pi-package', symlinks=True)
        shutil.copytree(BASE / 'npm', home / 'npm', symlinks=True)
        shutil.copytree(BASE / '.npm/_cacache', home / '.npm/_cacache', symlinks=True)
        (home / 'bin/npm').write_text('#!/bin/sh\nexec "$HOME/bin/node" "$HOME/npm/bin/npm-cli.js" "$@"\n')
        (home / 'bin/npm').chmod(0o755)
        (home / '.bashrc').write_text(f'. {home}/tools/env.sh\n')
        (home / '.profile').write_text(f'. {home}/tools/env.sh\n')
        shutil.copy2(home / 'tools/pi', home / 'bin/wall-pi')
        (home / 'bin/ha').symlink_to('herdr-ade')
        run('chown', '-R', f'{user}:{user}', home)
    # Restore box ownership after chown of the outer home; wall can reach the
    # scratch bare remote but not the box account's private state.
    run('chmod', '700', HOME / 'box')
    run('chown', '-R', 'wallbox:wallbox', HOME / 'box')
    for port in [PORT, BOX_PORT]:
        run('systemctl', 'start', f'{UNIT}-{port}')
    wait_port(PORT)
    wait_port(BOX_PORT)
    ssh('python3 "$HOME/tools/guest.py" init')
    ssh('python3 "$HOME/tools/guest.py" init', box=True)
    ssh('ssh-keygen -q -t ed25519 -N "" -f "$HOME/.ssh/box_key"')
    with (HOME / 'box/.ssh/authorized_keys').open('a') as keys:
        keys.write((HOME / '.ssh/box_key.pub').read_text())
    shutil.copy2(BASE / 'known_hosts', HOME / '.ssh/known_hosts')
    run('chown', 'wall:wall', HOME / '.ssh/known_hosts')
    ssh('python3 "$HOME/tools/guest.py" connect')
    print('Reset complete: 2048 MiB tmpfs, two isolated users/SSH servers, no provider credentials.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    p = sub.add_parser('install')
    p.add_argument('--build', required=True, help='directory containing current ADE binaries')
    p.add_argument('--herdr', required=True)
    p.add_argument('--node', required=True)
    p.add_argument('--npm', required=True, help='npm-cli.js executable link')
    sub.add_parser('reset')
    p = sub.add_parser('enter')
    p.add_argument('--box', action='store_true')
    p.add_argument('shell_command', nargs='?')
    p = sub.add_parser('fault')
    p.add_argument('kind', choices=['kill-pane', 'kill-process', 'ticker', 'disconnect', 'reboot',
                                    'fill', 'corrupt', 'clock', 'install'])
    p.add_argument('arguments', nargs='*')
    p.add_argument('--after', type=float, default=0)
    p.add_argument('--when', nargs=2, metavar=('THREAD', 'PHASE'), help='wait for scripted phase before injection')
    p.add_argument('--box', action='store_true')
    p = sub.add_parser('evidence')
    p.add_argument('destination', help='new host evidence directory (outside confined disk)')
    args = parser.parse_args()
    require_root()
    if args.command == 'install':
        install(args)
    elif args.command == 'reset':
        reset()
    elif args.command == 'enter':
        ssh(args.shell_command, args.box)
    elif args.command == 'evidence':
        dest = Path(args.destination).absolute()
        dest.mkdir(exist_ok=False, parents=True)
        # Deliberate allowlist: never export auth.json, SSH keys or pi sessions.
        for box in [False, True]:
            with (dest / ('box.tar' if box else 'local.tar')).open('wb') as output:
                args_ssh = ['ssh', '-F', '/dev/null', '-i', str(BASE / 'client'),
                            '-o', 'IdentitiesOnly=yes', '-o', 'StrictHostKeyChecking=yes',
                            '-o', f'UserKnownHostsFile={BASE}/known_hosts', '-p',
                            str(BOX_PORT if box else PORT),
                            f'{"wallbox" if box else "wall"}@127.0.0.1',
                            'python3 "$HOME/tools/guest.py" evidence']
                run(*args_ssh, stdout=output)
        print(dest)
    elif args.command == 'fault':
        if args.when:
            ssh('python3 "$HOME/tools/guest.py" wait ' + shlex.join(args.when), args.box)
        time.sleep(max(0, args.after))
        if args.kind in ['disconnect', 'reboot']:
            seconds = float(args.arguments[0]) if args.arguments else 3
            if not 0 <= seconds <= 300:
                sys.exit('duration must be 0..300 seconds')
            unit = f'{UNIT}-{BOX_PORT}'
            if args.kind == 'disconnect':
                # Stop only SSH transport processes in this fixed cgroup.
                # Pane agents, herdr and ticker keep running during the outage.
                cgroup = subprocess.check_output(['systemctl','show','-p','ControlGroup',
                                                   '--value',unit], text=True).strip()
                pids = set()
                for file in (Path('/sys/fs/cgroup') / cgroup.lstrip('/')).rglob('cgroup.procs'):
                    for pid in file.read_text().split():
                        proc = Path('/proc') / pid
                        if proc.exists() and (proc / 'comm').read_text().strip() == 'sshd':
                            pids.add(int(pid))
                import signal
                try:
                    for pid in pids:
                        os.kill(pid, signal.SIGSTOP)
                    time.sleep(seconds)
                finally:
                    for pid in pids:
                        try:
                            os.kill(pid, signal.SIGCONT)
                        except ProcessLookupError:
                            pass
                print(f'box SSH transport paused/restored ({sorted(pids)}); lane processes preserved')
            else:
                run('systemctl', 'stop', unit)
                time.sleep(seconds)
                run('systemctl', 'start', unit)
                wait_port(BOX_PORT)
                ssh('python3 "$HOME/tools/guest.py" boot', box=True)
                print('box rebooted: old cgroup killed, disk preserved, new server/ticker')
        elif args.kind == 'install':
            if len(args.arguments) != 1:
                sys.exit('install needs a directory with a different herdr-ade binary')
            source = Path(args.arguments[0]).resolve() / 'herdr-ade'
            home = HOME / 'box' if args.box else HOME
            current = home / 'bin/herdr-ade'
            if source == current.resolve():
                sys.exit('choose a different build')
            # Atomic swap; never run production harness install machinery.
            temporary = current.with_name('herdr-ade.next')
            shutil.copy2(source, temporary)
            run('chown', f'{"wallbox" if args.box else "wall"}:', temporary)
            temporary.replace(current)
            ssh('ha --version; ha ticker start; ha ticker status', args.box)
        else:
            command = ['python3', '$HOME/tools/guest.py', 'fault', args.kind, *args.arguments]
            ssh('python3 "$HOME/tools/guest.py" ' + shlex.join(command[2:]), args.box)


if __name__ == '__main__':
    main()
