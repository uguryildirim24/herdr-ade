#!/usr/bin/env python3
"""D39/R02: a dead waiting agent needs retry advice, not a connection check."""
import argparse
import json
from pathlib import Path
import sys
import time

from support import (enter, evidence, fault, phase, record, records, reset,
                     set_instance, snapshot, start, until)

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--instance', type=int, choices=range(1, 9))
parser.add_argument('--evidence', type=Path, required=True, help='new host evidence directory')
args = parser.parse_args()
set_instance(args.instance)
reset({'finish': 'waiting', 'hold': []})
try:
    lane = start()
    thread = lane['id']
    phase(thread, 'seal-end')
    seals = until(lambda: records(kind='events'), 'waiting seal present')
    assert any(e['payload'].get('waiting') for e in seals), 'no waiting seal'
    before = record(thread)
    fault('kill-process', thread)
    time.sleep(35)  # More than two ticker beats: no automatic restart is allowed.
    lane = record(thread)
    process = json.loads(enter('herdr pane process-info --pane ' + lane['pane_id']).stdout)
    info = process['result']['process_info']
    shell_only = (info['pane_id'] == lane['pane_id']
                  and all(p['name'] in ('bash', 'sh', 'zsh', 'fish')
                          for p in info['foreground_processes']))
    view = enter('ha overview wall').stdout
    snapshot()
    passed = (shell_only and 'agent gone, waiting seal kept' in view
              and f'ha thread retry wall {thread} --reason' in view
              and 'process unknown; check the connection' not in view
              and lane['status'] == 'open' and lane['attempt'] == before['attempt']
              and not lane['recovery_pending'] and records(kind='events') == seals)
    print('EXPECTED: agent gone, waiting seal kept, with thread retry; no automatic restart.')
    print('ACTUAL:', {'shell_only': shell_only,
                      'correct_advice': 'agent gone, waiting seal kept' in view,
                      'status': lane['status'], 'attempt': lane['attempt'],
                      'seal_unchanged': records(kind='events') == seals})
    print('R02 PASS' if passed else 'R02 FAIL', flush=True)
finally:
    evidence(args.evidence)
sys.exit(0 if passed else 1)
