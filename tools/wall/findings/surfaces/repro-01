#!/usr/bin/env python3
"""S01: task/seal corruption must reach Rundown's unavailable-record diagnostic."""
import argparse
import json
from pathlib import Path
import subprocess
import tempfile

parser = argparse.ArgumentParser()
parser.add_argument('--instance', required=True, type=int, choices=range(1, 9))
parser.add_argument('--evidence', type=Path)
a = parser.parse_args()
here = Path(__file__).resolve().parent
folder = a.evidence or Path(tempfile.mkdtemp(prefix='wall-surfaces-S01-'))
folder.mkdir(parents=True, exist_ok=True)
failed = False
for scenario in ['corrupt-task', 'corrupt-event']:
    evidence = folder / scenario
    with (folder / (scenario + '.log')).open('w') as output:
        subprocess.run([str(here / 'run-scenario'), '--instance', str(a.instance),
                        '--evidence', str(evidence), scenario], check=True,
                       stdout=output, stderr=subprocess.STDOUT)
    text = (evidence / 'during.log').read_text()
    if '{invalid wall record' not in text:
        raise RuntimeError('corruption was not observed')
    def section(command):
        return text.split('=== COMMAND ' + command + '\n', 1)[1].split('\n=== ', 1)[0]
    view = json.loads(section('ha --json overview wall').rsplit('EXIT ', 1)[0])['data']['result']
    rundown = section('herdr-rundown --print')
    status = int(rundown.rsplit('EXIT ', 1)[1].strip())
    print(f'EXPECTED {scenario}: known unreadable evidence is visible in Rundown, '
          'with nonempty overview read_error and nonzero --print status', flush=True)
    print(f'ACTUAL {scenario}: read_error={view["read_error"]!r}, '
          f'Rundown exit={status}\n{rundown}', flush=True)
    failed |= not view['read_error'] or status == 0
print('Evidence:', folder, flush=True)
raise SystemExit(1 if failed else 0)
