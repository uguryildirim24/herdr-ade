#!/bin/bash
# D60: repository review placement must override a ready dispatch box.
set -euo pipefail
[[ ${1:-} == --instance && ${2:-} =~ ^[1-8]$ && $# == 2 ]] || { echo 'usage: repro --instance N (1..8)' >&2; exit 2; }
wall=$(dirname "$(readlink -f "$0")")/../../wall
sudo -n "$wall" --instance "$2" reset
sudo -n "$wall" --instance "$2" enter 'python3 "$HOME/tools/regressions/D60/journey.py"'
