#!/bin/bash
# D30: a real corrupt lane must remain visible, never disappear as "no work".
set -euo pipefail
[[ ${1:-} == --instance && ${2:-} =~ ^[1-8]$ && $# == 2 ]] || { echo 'usage: repro --instance N (1..8)' >&2; exit 2; }
wall=$(dirname "$(readlink -f "$0")")/../../wall
sudo -n "$wall" --instance "$2" reset
sudo -n "$wall" --instance "$2" enter 'python3 "$HOME/tools/guest.py" regression-D30'
