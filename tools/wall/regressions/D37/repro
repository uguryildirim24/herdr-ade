#!/usr/bin/env python3
"""D37: a remote retry must discard the previous attempt's bootstrap."""
import json
from pathlib import Path
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from support import enter, evidence, fault, phase, quiet_py, record, repro_args, reset, snapshot, start, until

args = repro_args(__doc__)
reset({'hold': ['working']}, box=True)
try:
    lane = start(box=True)
    thread = lane['id']
    phase(thread, 'working', box=True)
    until(lambda: record(thread)['bootstrap'] == 'acknowledged', 'original bootstrap imported')
    original = record(thread)
    fault('kill-process', thread, box=True)
    until(lambda: record(thread)['status'] == 'failed', 'process death classified')
    enter(f'ha thread retry wall {thread} --reason "D37 killed the remote agent"')
    until(lambda: record(thread)['attempt'] == 2 and not record(thread)['recovery_pending'],
          'replacement placed')
    # At least two courier passes; this is longer than the 30s ready timeout.
    time.sleep(40)
    lane = record(thread)
    snapshot()
    process = enter('herdr pane process-info --pane ' + lane['pane_id'], box=True).stdout
    foreground = json.loads(process)['result']['process_info']['foreground_processes']
    working = quiet_py('import pathlib,os,json; '
          'rows=[json.loads(line) for f in (pathlib.Path(os.environ["HOME"])/"runs").glob("*.jsonl") '
          'for line in f.read_text().splitlines()]; '
          f'print(json.dumps([r for r in rows if r["pane"] == {lane["pane_id"]!r} '
          'and r["phase"] == "working"]))', box=True)
    fixed = (lane['attempt'] == 2 and lane['status'] == 'open'
             and lane['bootstrap'] == 'acknowledged' and lane['brief_submitted']
             and not lane['prompt_pending'] and lane['launch_attempts'] == 1
             and lane['pane_id'] != original['pane_id']
             and lane['worktree_path'] == original['worktree_path']
             and lane['launch']['brief_hash'] == original['launch']['brief_hash']
             and len(working) == 1
             and any(p['pid'] == working[0]['pid'] and p['name'] == 'pi' for p in foreground))
    stuck = (lane['bootstrap'] == 'acknowledged' and not lane['prompt_pending']
             and not lane['brief_submitted'] and lane['launch_attempts'] == 0
             and lane['status'] == 'open' and '"name":"bash"' in process)
    print('EXPECTED: retry launches one replacement agent and delivers the frozen brief on the preserved checkout.')
    print('ACTUAL:', {k: lane.get(k) for k in ('attempt', 'status', 'bootstrap',
          'launch_attempts', 'brief_submitted', 'prompt_pending', 'startup_wait_started')})
    print('WORKING:', working)
    print('D37 PASS' if fixed else ('D37 REPRODUCED' if stuck else 'D37 recovery not established'), flush=True)
finally:
    evidence(args.evidence)
sys.exit(0 if fixed else 1)
