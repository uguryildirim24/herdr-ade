#!/bin/bash
# D67: actual Git metadata loss and >1 MiB ignored status in a reset wall.
set -euo pipefail
[[ ${1:-} == --instance && ${2:-} =~ ^[1-8]$ && $# == 2 ]] || { echo 'usage: repro --instance N (1..8)' >&2; exit 2; }
wall=$(dirname "$(readlink -f "$0")")/../../wall
sudo -n "$wall" --instance "$2" reset
sudo -n "$wall" --instance "$2" enter "$(/usr/bin/python3 - <<'HOST'
import shlex
script = r'''
import hashlib, json, os, pathlib, shlex, shutil, subprocess, sys
home = pathlib.Path.home()
repo = home / 'd67-repo'
repo.mkdir()
def git(*args, cwd=repo):
    return subprocess.check_output(['/usr/bin/git', '-C', str(cwd), *args], stderr=subprocess.STDOUT).decode().strip()
git('init', '-q', '-b', 'main')
git('config', 'user.name', 'D67')
git('config', 'user.email', 'd67@localhost')
(repo/'README').write_text('retained work\n')
(repo/'.gitignore').write_text('cache/\n')
git('add', '.'); git('commit', '-qm', 'seed')
checkout = repo / '.worktrees/lane'
git('worktree', 'add', '-qb', 'lane', str(checkout))
sha = git('rev-parse', 'lane')
admin = pathlib.Path((checkout/'.git').read_text().strip().removeprefix('gitdir: '))
shutil.rmtree(admin)
version = subprocess.check_output(['ha', '--version'], text=True).strip().split(' ', 1)[1]
def inspect():
    request = {'Inspect': {'path': str(checkout), 'repair': [str(repo), 'lane', sha], 'disposable': ['cache'], 'report_stored': True}}
    out = subprocess.run(['ha', 'doctor'], input=json.dumps({'build': version, 'request': request}), text=True, capture_output=True, env=dict(os.environ, HERDR_ADE_BOX_INPUT='1'))
    try: return json.loads(out.stdout.splitlines()[-1])
    except Exception: return {'status': 'Failed', 'detail': out.stderr or out.stdout}
result = inspect()
print('EXPECTED missing-admin inspection: Ready, clean, unique branch preserved')
print('ACTUAL', json.dumps(result))
passed = result.get('status') == 'Ready' and not result['result']['dirty'] and git('rev-parse', 'lane') == sha
if passed:
    cache = checkout/'cache'; cache.mkdir()
    for n in range(12000): (cache/(f'{n:05}-'+'x'*90)).write_text('')
    raw = subprocess.check_output(['/usr/bin/git', '-C', str(checkout), 'status', '--porcelain', '--ignored', '--untracked-files=all', '-z'])
    assert len(raw) > 1048576
    result = inspect()
    print('EXPECTED large ignored status: Ready, no kept data; status bytes', len(raw))
    print('ACTUAL', json.dumps(result))
    passed = result.get('status') == 'Ready' and result['result'] == {'dirty': [], 'ignored_data': []}
# A resolved, uninspectable box checkout must not pin either kind of cache.
sys.path.insert(0, str(home/'tools'))
from instance import Instance
instance = Instance(int(os.environ.get('WALL_INSTANCE', '0')))
box = home/'box'
thread = 't-0999'
box_checkout = box/'repo/.worktrees'/thread
branch = 'hp/wall/'+thread
private = box/'.herdr-ade/.execution'/hashlib.sha256(f'{box}/.herdr-ade\0{thread}\01\0{box_checkout}'.encode()).hexdigest()
cache = box/'build'/('wall-'+thread)
setup = f"""import pathlib, subprocess, shutil
repo=pathlib.Path.home()/'repo'; checkout=pathlib.Path({str(box_checkout)!r})
subprocess.run(['git','-C',str(repo),'worktree','add','-qb',{branch!r},str(checkout)],check=True)
admin=pathlib.Path((checkout/'.git').read_text().strip().removeprefix('gitdir: ')); shutil.rmtree(admin)
for path in [{str(cache)!r}, {str(private/'build')!r}]:
 p=pathlib.Path(path); p.mkdir(parents=True); (p/'rebuildable').write_text('cache')
(pathlib.Path({str(private)!r})/'retained-runtime').write_text('not a build cache')
"""
subprocess.run(['ssh',instance.machine,'python3 -c '+shlex.quote(setup)],check=True)
records = home/'.herdr-ade/wall/.state/threads'; records.mkdir(exist_ok=True)
record = f"""id = "{thread}"
kind = "worktree"
status = "resolved"
repo = "{home}/repo"
branch = "{branch}"
machine = "{instance.machine}"
worktree_path = "{box_checkout}"
cwd = "{box_checkout}"
merged_sha = "fixture-landed"
cleanup_pending = true
[retirement]
skip_copy = true
"""
(records/(thread+'.toml')).write_text(record)
resolved = subprocess.run(['ha','--json','thread','resolve','wall',thread,'--skip-copy'],capture_output=True,text=True)
probe = f'test -e {shlex.quote(str(box_checkout))} && test ! -e {shlex.quote(str(cache))} && test ! -e {shlex.quote(str(private/"build"))} && test -f {shlex.quote(str(private/"retained-runtime"))}'
cleaned = subprocess.run(['ssh',instance.machine,probe],capture_output=True,text=True).returncode == 0
print('EXPECTED refused resolved checkout: kept; lane and private caches removed; other runtime retained')
print('ACTUAL', 'cache obligation completed' if cleaned else 'cache pinned', 'resolve:', resolved.stdout.strip() or resolved.stderr.strip())
passed = passed and cleaned
sys.exit(0 if passed else 1)
'''
print('python3 -c ' + shlex.quote(script))
HOST
)"
