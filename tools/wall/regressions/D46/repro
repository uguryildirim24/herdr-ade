#!/bin/bash
# D46: ownership must be visible before a second coordinator starts, not after readiness.
set -euo pipefail
[[ ${1:-} == --instance && ${2:-} =~ ^[1-8]$ && $# == 2 ]] || { echo 'usage: repro --instance N (1..8)' >&2; exit 2; }
base=$(dirname "$(readlink -f "$0")")
wall=$base/../../wall
sudo -n "$wall" --instance "$2" reset
# The selected disposable instance belongs to this repro until its final reset.
trap 'sudo -n "$wall" --instance "$2" reset >/dev/null' EXIT
sudo -n "$wall" --instance "$2" enter 'python3 -' < "$base/guest.py"
