#!/usr/bin/env python3
"""D39/R02: a dead waiting agent needs retry advice, not a connection check."""
import json
from pathlib import Path
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from support import (control, enter, evidence, fault, phase, record, records, repro_args,
                     reset, snapshot, start, until)

args = repro_args(__doc__)
reset({'finish': 'waiting', 'hold': []})
try:
    lane = start()
    thread = lane['id']
    phase(thread, 'seal-end')
    seals = until(lambda: records(kind='events'), 'waiting seal present')
    assert any(e['payload'].get('waiting') for e in seals), 'no waiting seal'
    before = record(thread)
    fault('kill-process', thread)
    time.sleep(35)  # More than two ticker beats: no automatic restart is allowed.
    lane = record(thread)
    process = json.loads(enter('herdr pane process-info --pane ' + lane['pane_id']).stdout)
    info = process['result']['process_info']
    shell_only = (info['pane_id'] == lane['pane_id']
                  and all(p['name'] in ('bash', 'sh', 'zsh', 'fish')
                          for p in info['foreground_processes']))
    view = enter('ha overview wall').stdout
    snapshot()
    passed = (shell_only and 'agent gone, waiting seal kept' in view
              and f'ha thread retry wall {thread} --reason' in view
              and 'process unknown; check the connection' not in view
              and lane['status'] == 'open' and lane['attempt'] == before['attempt']
              and not lane['recovery_pending'] and records(kind='events') == seals)
    print('EXPECTED: agent gone, waiting seal kept, with thread retry; no automatic restart.')
    print('ACTUAL:', {'shell_only': shell_only,
                      'correct_advice': 'agent gone, waiting seal kept' in view,
                      'status': lane['status'], 'attempt': lane['attempt'],
                      'seal_unchanged': records(kind='events') == seals})
    if passed:
        # Only a deliberate continuation may replace the dead waiting agent.
        # Use the advertised command and keep the old seal as durable evidence.
        control({'hold': ['working']})
        enter(f'ha thread retry wall {thread} --reason "input is ready; continue preserved work"')
        until(lambda: record(thread)['attempt'] == before['attempt'] + 1,
              'deliberate retry selected replacement attempt')
        replacement = until(lambda: (r if (r := record(thread))['identity'].get('process')
                                     and r['identity']['process'] != before['identity']['process']
                                     else None), 'replacement agent bound')
        live = json.loads(enter('herdr pane process-info --pane ' + replacement['pane_id']).stdout)
        info = live['result']['process_info']
        passed = (replacement['worktree_path'] == before['worktree_path']
                  and records(kind='events') == seals and replacement['status'] == 'open'
                  and info['pane_id'] == replacement['pane_id']
                  and any(p['pid'] == replacement['identity']['process']['pid']
                          for p in info['foreground_processes']))
        print('RETRY:', {'replacement_agent': replacement['identity']['process'],
                         'same_worktree': replacement['worktree_path'] == before['worktree_path'],
                         'waiting_seal_kept': records(kind='events') == seals})
    print('D39 PASS' if passed else 'D39 FAIL', flush=True)
finally:
    evidence(args.evidence)
sys.exit(0 if passed else 1)
