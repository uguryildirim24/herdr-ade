#!/bin/sh
# SPEC-ADE §4.3: the reviewer's acceptance test.
#
# Every row is assembled from parts. A part is one of:
#   det   a named unit test (FakeRunner, fault injection); read from one
#         `cargo test` run of this checkout
#   mod   tests another lane owns, matched by a name pattern for the new
#         behaviour (never a base-plugin module alone); zero matches is FAIL
#   cli   a real command of the release binary against a throwaway root and
#         a fixture repository; no herdr server needed
#   live  needs the throwaway herdr session and real agent CLIs; runs only
#         with ACC_LIVE=1 and its prerequisites, else NOT-RUN with the reason
#
# A row is PASS when every part is PASS. Every row is required (D15:
# claude, cursor and chatgpt rows plus every deterministic row); a required
# row with a part that did not run is FAIL, not NOT-RUN. Optional parts
# (the unqualified kinds in row 9) may be NOT-RUN without failing the row.
#
# Output: one line per row `STATUS<TAB>id<TAB>title`, its parts indented
# below it, then `REQUIRED<TAB>PASS|FAIL<TAB>n/m pass`. Exit 0 only when every
# required row is PASS.
#
# Environment:
#   HA            the plugin binary (default: <checkout>/target/release/herdr-ade,
#                 or $CARGO_TARGET_DIR/release/herdr-ade)
#   HP            the pi helper (default: next to HA)
#   HERDR_BIN_PATH the qualified herdr binary C (live rows)
#   ACC_LIVE=1    run the live parts (throwaway session, real agent CLIs)
#   ACC_SESSION   throwaway session name (default acc-<pid>; must start with acc-)
#   ACC_DIR       scratch directory (default /var/tmp/ade-acc-<pid>)
#   ACC_SKIP_TESTS=1  reuse $ACC_DIR/tests.txt instead of running cargo test

set -u

here=$(cd "$(dirname "$0")" && pwd)
checkout=$(cd "$here/../.." && pwd)
target=${CARGO_TARGET_DIR:-$checkout/target}
HA=${HA:-$target/release/herdr-ade}
HP=${HP:-$target/release/herdr-pi}
ACC_DIR=${ACC_DIR:-/var/tmp/ade-acc-$$}
ACC_SESSION=${ACC_SESSION:-acc-$$}
ACC_LIVE=${ACC_LIVE:-0}

case "$ACC_SESSION" in
  acc-*) ;;
  *) echo "ACC_SESSION must start with acc- (got $ACC_SESSION)" >&2; exit 2 ;;
esac
case "$ACC_DIR" in
  /var/tmp/*|/tmp/*|/private/tmp/*|/private/var/tmp/*) ;;
  *) echo "ACC_DIR must be under /var/tmp or /tmp (got $ACC_DIR)" >&2; exit 2 ;;
esac

mkdir -p "$ACC_DIR"
# Isolation: nothing below reads or writes the real roots or configs.
export HERDR_ADE_ROOT="$ACC_DIR/root"
export XDG_CONFIG_HOME="$ACC_DIR/xdg"
export XDG_STATE_HOME="$ACC_DIR/state"
mkdir -p "$HERDR_ADE_ROOT" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME"
unset HERDR_PANE_ID HERDR_SOCKET_PATH HERDR_SESSION 2>/dev/null || true

TAB=$(printf '\t')
rows_total=0
rows_pass=0
row_parts=""
row_ok=1

# ----------------------------------------------------------------- report

part() { # part STATUS KIND DESC [REASON] [optional]
  st=$1 kind=$2 desc=$3 reason=${4:-} opt=${5:-}
  line="  $st$TAB$kind$TAB$desc"
  [ -n "$reason" ] && line="$line ($reason)"
  row_parts="$row_parts$line
"
  if [ "$st" != PASS ] && [ "$opt" != optional ]; then
    row_ok=0
  fi
}

row_begin() { row_parts=""; row_ok=1; }

row_end() { # row_end ID TITLE
  rows_total=$((rows_total + 1))
  if [ "$row_ok" = 1 ]; then
    rows_pass=$((rows_pass + 1))
    printf 'PASS%s%s%s%s\n' "$TAB" "$1" "$TAB" "$2"
  else
    printf 'FAIL%s%s%s%s\n' "$TAB" "$1" "$TAB" "$2"
  fi
  printf '%s' "$row_parts"
}

# ------------------------------------------------------------ unit tests

tests="$ACC_DIR/tests.txt"
if [ "${ACC_SKIP_TESTS:-0}" != 1 ] || [ ! -s "$tests" ]; then
  (cd "$checkout" && cargo test --locked --bin herdr-ade 2>&1) >"$tests"
fi

det() { # det DESC test::path...
  desc=$1; shift
  for t in "$@"; do
    if grep -q "^test $t \.\.\. ok\$" "$tests"; then
      :
    elif grep -q "^test $t \.\.\. FAILED\$" "$tests"; then
      part FAIL det "$desc" "failed: $t"; return
    else
      part FAIL det "$desc" "missing test: $t"; return
    fi
  done
  part PASS det "$desc" "$# tests"
}

mod() { # mod DESC OWNER REGEX: tests another lane owns, by name pattern
  desc=$1 owner=$2 re=$3
  # The pattern names the new behaviour, not a module the base plugin
  # already tests, so base tests never pass for a lane's missing ones.
  if grep -E "^test ($re)[^ ]* \.\.\. FAILED\$" "$tests" >/dev/null; then
    part FAIL mod "$desc" "failed: $(grep -E "^test ($re)[^ ]* \.\.\. FAILED\$" "$tests" | head -1 | cut -d' ' -f2)"; return
  fi
  n=$(grep -E -c "^test ($re)[^ ]* \.\.\. ok\$" "$tests")
  if [ "$n" -eq 0 ]; then
    part FAIL mod "$desc" "no test matches /$re/ (lane $owner)"
  else
    part PASS mod "$desc" "$n tests"
  fi
}

# ---------------------------------------------------------------- cli parts

ha() { "$HA" "$@"; }

has_verb() { # has_verb "thread start" [--flag]
  words=$1 flag=${2:-}
  # shellcheck disable=SC2086
  out=$("$HA" $words --help 2>&1) || return 1
  [ -z "$flag" ] && return 0
  printf '%s' "$out" | grep -q -- "$flag"
}

fixture_repo() { # fresh repository with one commit on main
  r="$ACC_DIR/repo-$1"
  rm -rf "$r"
  git init -q -b main "$r"
  git -C "$r" config user.name acceptance
  git -C "$r" config user.email acceptance@example.invalid
  git -C "$r" config commit.gpgsign false
  printf '.worktrees/\n' >>"$r/.git/info/exclude"
  printf 'fixture\n' >"$r/README.md"
  git -C "$r" add README.md
  git -C "$r" commit -q -m initial
  printf '%s' "$r"
}

cli() { # cli DESC EXPECT(ok|fail) PATTERN -- command...
  desc=$1 expect=$2 pattern=$3; shift 4
  out=$("$@" 2>&1); code=$?
  if [ "$expect" = ok ] && [ $code -ne 0 ]; then
    part FAIL cli "$desc" "exit $code: $(printf '%s' "$out" | head -1)"; return
  fi
  if [ "$expect" = fail ] && [ $code -eq 0 ]; then
    part FAIL cli "$desc" "expected a refusal, exit 0"; return
  fi
  if [ -n "$pattern" ] && ! printf '%s' "$out" | grep -q -- "$pattern"; then
    part FAIL cli "$desc" "output lacks '$pattern': $(printf '%s' "$out" | head -1)"; return
  fi
  part PASS cli "$desc"
}

# ------------------------------------------------------------- live setup

live_reason=""
if [ "$ACC_LIVE" != 1 ]; then
  live_reason="ACC_LIVE is not 1"
elif [ -z "${HERDR_BIN_PATH:-}" ] || [ ! -x "${HERDR_BIN_PATH:-}" ]; then
  live_reason="HERDR_BIN_PATH is not the qualified herdr binary"
fi

H() { # herdr on the throwaway session only, never an inherited target
  "$HERDR_BIN_PATH" --session "$ACC_SESSION" "$@"
}

live_start() {
  [ -n "$live_reason" ] && return 1
  [ -f "$ACC_DIR/server.pid" ] && return 0
  env -u CLAUDE_CODE_CHILD_SESSION -u HERDR_SOCKET_PATH -u HERDR_PANE_ID \
    "$HERDR_BIN_PATH" --session "$ACC_SESSION" server >"$ACC_DIR/server.log" 2>&1 &
  echo $! >"$ACC_DIR/server.pid"
  i=0
  while [ $i -lt 50 ]; do
    H workspace list >/dev/null 2>&1 && return 0
    sleep 0.2; i=$((i + 1))
  done
  live_reason="the throwaway session $ACC_SESSION did not come up (see $ACC_DIR/server.log)"
  return 1
}

live() { # live DESC FUNCTION [optional]
  desc=$1 fn=$2 opt=${3:-}
  if ! live_start; then
    part NOT-RUN live "$desc" "$live_reason" "$opt"; return
  fi
  reason=$("$fn" 2>&1 | tail -1); code=$?
  case "$reason" in
    NOT-RUN:*) part NOT-RUN live "$desc" "${reason#NOT-RUN: }" "$opt" ;;
    PASS*) part PASS live "$desc" "" "$opt" ;;
    *) part FAIL live "$desc" "$reason" "$opt" ;;
  esac
  : "$code"
}

need_verb() { # prints the NOT-RUN line when a verb or flag is missing
  if ! has_verb "$1" "${2:-}"; then
    echo "NOT-RUN: \`$1 ${2:-}\` is not in this binary (lane $3)"
    return 1
  fi
}

wait_for() { # wait_for SECONDS command...
  s=$1; shift
  end=$(($(date +%s) + s))
  while [ "$(date +%s)" -lt "$end" ]; do
    "$@" >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

# ---------------------------------------------------------------- preflight

{
  echo "== preflight $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "checkout: $checkout ($(git -C "$checkout" rev-parse HEAD 2>/dev/null))"
  echo "plugin:   $HA ($("$HA" --version 2>&1 | head -1))"
  echo "herdr:    ${HERDR_BIN_PATH:-unset} ($([ -x "${HERDR_BIN_PATH:-}" ] && "$HERDR_BIN_PATH" --version 2>&1 | head -1))"
  for cli in claude cursor-agent codex opencode agy dsh pro-mcp; do
    p=$(command -v "$cli" 2>/dev/null || true)
    if [ -n "$p" ]; then
      v=$("$p" --version 2>&1 | head -1)
      echo "cli $cli: $p ($v)"
    else
      echo "cli $cli: not installed"
    fi
  done
  # Credentials: presence only, never the secret.
  echo "credentials: claude keeps its login in the macOS keychain; not probed"
  for f in "$HOME/.cursor/cli-config.json" "$HOME/.codex/auth.json"; do
    if [ -e "$f" ]; then echo "credentials: $f present"; else echo "credentials: $f absent"; fi
  done
  echo "isolation: HERDR_ADE_ROOT=$HERDR_ADE_ROOT XDG_CONFIG_HOME=$XDG_CONFIG_HOME XDG_STATE_HOME=$XDG_STATE_HOME session=$ACC_SESSION"
  echo "launch: env -u CLAUDE_CODE_CHILD_SESSION $HERDR_BIN_PATH --session $ACC_SESSION server"
  echo "live: ${live_reason:-on}"
} >"$ACC_DIR/preflight.txt" 2>&1
cat "$ACC_DIR/preflight.txt"
echo

if [ ! -x "$HA" ]; then
  echo "no plugin binary at $HA; run cargo build --release --locked" >&2
  exit 2
fi

echo "ADE acceptance (SPEC-ADE §4.3)"

# ------------------------------------------------------------------ live rows
# Each function prints its last line as PASS, NOT-RUN: <why>, or the failure.

# Live parts run in subshells; what they share lives in files under ACC_DIR.
REPO_LIVE="$ACC_DIR/repo-live"

# Every Claude pane this script starts runs Haiku with the permission flag:
# the throwaway roles table pins it for every Claude role.
mkdir -p "$XDG_CONFIG_HOME/herdr-ade"
cat >"$XDG_CONFIG_HOME/herdr-ade/config.toml" <<'TOML'
[roles.coordinator]
kind = "claude"
args = ["--model", "claude-haiku-4-5-20251001", "--dangerously-skip-permissions"]
plain = "the quick helper"

[roles.lane]
kind = "claude"
args = ["--model", "claude-haiku-4-5-20251001", "--dangerously-skip-permissions"]
plain = "the quick helper"

[roles.reviewer]
kind = "claude"
args = ["--model", "claude-haiku-4-5-20251001", "--dangerously-skip-permissions"]
plain = "the quick helper"

[roles.critic]
kind = "claude"
args = ["--model", "claude-haiku-4-5-20251001", "--dangerously-skip-permissions"]
plain = "the quick helper"

[roles.drafter]
kind = "claude"
args = ["--model", "claude-haiku-4-5-20251001", "--dangerously-skip-permissions"]
plain = "the quick helper"
TOML
live_new_open() {
  need_verb "open" "--session" A2 || return
  fixture_repo live >/dev/null
  # `new --plain` is a later lane (SPEC-ADE item 70).
  ha new acc --repo "$REPO_LIVE" >/dev/null || { echo "ha new failed"; return; }
  ha open acc --session "$ACC_SESSION" >"$ACC_DIR/open.txt" 2>&1 || { echo "ha open failed: $(tail -1 "$ACC_DIR/open.txt")"; return; }
  coord="$HERDR_ADE_ROOT/acc/.state/coordinator.json"
  grep -q 'plain hook --kind claude' "$HERDR_ADE_ROOT/acc/.claude/settings.json" 2>/dev/null ||
    { echo "no hook in the project's own .claude/settings.json"; return; }
  wait_for 120 grep -q '"bootstrap": *"acknowledged"' "$coord" || { echo "bootstrap not acknowledged within 120 s"; return; }
  echo PASS
}

live_round_lanes() {
  need_verb "thread start" "--role" A1 || return
  [ -f "$HERDR_ADE_ROOT/acc/PROJECT.md" ] || { echo "NOT-RUN: row 1 did not create the project"; return; }
  ha round open acc r1 --branch main --plain "The first round of the test." --repo "$REPO_LIVE" >/dev/null || { echo "round open failed"; return; }
  # Two Claude lanes; no Cursor pane in a throwaway (row 9 says why).
  for n in one two; do
    printf 'Write the file notes/%s.txt with one line and commit it, then finish as your brief says.\n' "$n" |
      ha thread start acc --title "note $n" --role lane --plain "A small lane that writes one note." --task-file - >"$ACC_DIR/start-$n.txt" 2>&1 ||
      { echo "thread start --role lane failed: $(tail -1 "$ACC_DIR/start-$n.txt")"; return; }
    id=$(grep -o 't-[0-9]*' "$ACC_DIR/start-$n.txt" | head -1)
    ha round admit acc r1 "$id" >/dev/null || { echo "round admit $id failed"; return; }
    echo "$id" >>"$ACC_DIR/lanes.txt"
  done
  for id in $(cat "$ACC_DIR/lanes.txt"); do
    H api snapshot | grep -q "\"parent\"" || { echo "no parent token on the lanes"; return; }
    git -C "$REPO_LIVE" log --format=%s main | grep -q "$id" || { echo "the brief for $id is not a commit on main"; return; }
  done
  echo PASS
}

live_done_events() {
  need_verb "done" "--sha" A2 || return
  need_verb "waiting" "" A2 || return
  [ -s "$ACC_DIR/lanes.txt" ] || { echo "NOT-RUN: row 2 did not start lanes"; return; }
  for id in $(cat "$ACC_DIR/lanes.txt"); do
    wait_for 900 sh -c "grep -l 'thread = \"$id\"' '$HERDR_ADE_ROOT/acc/events/'*.toml 2>/dev/null | xargs grep -q 'payload.done'" ||
      { echo "no sealed done event for $id within 15 minutes"; return; }
  done
  ha context acc --peek >"$ACC_DIR/peek.txt" 2>&1
  grep -q acknowledged "$ACC_DIR/peek.txt" && { echo "--peek acknowledged an event"; return; }
  echo PASS
}

live_handoff() {
  echo "NOT-RUN: the 21-pane representative topology and the restart drill need lane/restart-core's herdr server restart in C; the deterministic half runs as det parts"
}

live_review() {
  need_verb "round review" "" A3 || return
  [ -s "$ACC_DIR/lanes.txt" ] || { echo "NOT-RUN: rows 2 and 3 did not complete"; return; }
  ha round review acc r1 >"$ACC_DIR/review.txt" 2>&1 || { echo "round review failed: $(tail -1 "$ACC_DIR/review.txt")"; return; }
  b=$(git -C "$REPO_LIVE" rev-parse main)
  git -C "$REPO_LIVE" rev-parse --verify -q review/r1 >/dev/null || { echo "no review/r1 branch"; return; }
  [ "$(git -C "$REPO_LIVE" merge-base main review/r1)" = "$b" ] || { echo "review/r1 does not start at B"; return; }
  echo "NOT-RUN: the reviewer thread (A1 thread start --role reviewer) must produce C and V; B and review/r1 checked"
}

live_pro() {
  command -v pro-mcp >/dev/null 2>&1 || { echo "NOT-RUN: pro-mcp is not installed"; return; }
  need_verb "thread adopt" "--passive" A1 || return
  echo "NOT-RUN: needs a logged-in ChatGPT Pro pane; start it with pro-mcp start --name pro --parent <coordinator pane>, then dialogue start/critic/turn/commit"
}

live_kind_claude() { need_verb "thread start" "--role" A1 || return; echo "NOT-RUN: covered by row 2's claude lane once it passes"; }
live_kind_cursor() { echo "NOT-RUN: no Cursor pane in the reviewer's throwaway (brief); Cursor's row runs on install day"; }
live_kind_other() { echo "NOT-RUN: unqualified kind, not started this round"; }

live_plain_hook() {
  need_verb "plain hook" "--kind" A2 || return
  echo "NOT-RUN: needs the claude coordinator from row 1 and a hook barrier; captures with agent read and pane read"
}

live_board_readback() {
  [ -f "$HERDR_ADE_ROOT/acc/PROJECT.md" ] || { echo "NOT-RUN: row 1 did not open the project"; return; }
  ha board acc >/dev/null 2>&1 || { echo "ha board failed"; return; }
  snap=$(H api snapshot 2>/dev/null)
  for k in ade_stage ade_lanes ade_needs_you ade_last ade_updated; do
    printf '%s' "$snap" | grep -q "\"$k\"" || { echo "board token $k not on the workspace"; return; }
  done
  echo PASS
}

live_stop() {
  [ -f "$ACC_DIR/server.pid" ] || { echo "NOT-RUN: no throwaway server was started"; return; }
  sock_dir="$XDG_CONFIG_HOME/herdr"
  # The wrapper validated the session name and XDG dir at the top; stop only this one.
  H session stop "$ACC_SESSION" >/dev/null 2>&1
  rm -f "$ACC_DIR/server.pid"
  out=$(ha doctor 2>&1)
  printf '%s' "$out" | grep -qi 'unreachable\|not running\|FAIL' || { echo "doctor did not report the session unreachable"; return; }
  [ -f "$HERDR_ADE_ROOT/acc/PROJECT.md" ] || { echo "records missing after stop"; return; }
  : "$sock_dir"
  echo PASS
}

# ----------------------------------------------------------------- the rows

row_begin
live "ha new and open, hook before launch, bootstrap acknowledged within 120 s" live_new_open
mod "priming held until the receipt, and hook install" A2 "ticker::tests::(pending_prime|rejected_prime)|hook::tests::claude_install"
row_end 1 "ha new and open with claude coordinator: hook before launch, bootstrap acknowledged"

row_begin
REPO_CLI=$(fixture_repo cli)
ha new cli >/dev/null 2>&1 || true
cli "round open without --plain is refused" fail plain_missing -- \
  "$HA" round open cli r1 --branch main --repo "$REPO_CLI"
cli "round open with --plain records the round" ok "" -- \
  "$HA" round open cli r1 --branch main --plain "The first round of the test." --repo "$REPO_CLI"
cli "the round's sentence is in GLOSSARY.md" ok "r1: The first round of the test." -- \
  cat "$HERDR_ADE_ROOT/cli/GLOSSARY.md"
live "two claude lanes admitted: tabs, parent, briefs committed first" live_round_lanes
mod "brief committed before the worktree, launch record" A1 "git::|threads::[a-z_:]*(brief_committed|brief_before|launch_record)"
row_end 2 "round open r1; claude and cursor lanes admitted: tabs, parent, briefs committed first"

row_begin
live "each lane's ha done seals an event; peek does not acknowledge" live_done_events
mod "done, waiting, seal and acknowledgement" A2 "(lane|events|ops)::"
det "admission pins only sealed done events of the current attempt" \
  round::tests::a_later_attempt_unpins_and_bumps_the_revision \
  round::tests::remote_thread_is_not_admissible
row_end 3 "each lane ha done seals events; peek does not acknowledge; unadmitted ha waiting from a dirty tree"

row_begin
live "representative-topology continuity across a restart" live_handoff
det "delivery: blocked keeps the request queued, then submitted in order" \
  talk::tests::a_blocked_coordinator_keeps_the_request_queued_and_gets_one_notice \
  talk::tests::a_refusal_before_typing_stays_queued_and_is_sent_later_in_order \
  talk::tests::a_timeout_is_uncertain_and_never_resent
mod "outbox delivery, duplicate typed line consumed once by id" A2 "events::tests::delivery_journal|inbox::tests::event_receipts"
row_end 4 "representative-topology handoff continuity and blocked-then-submitted delivery"

row_begin
det "B committed before review/r1; brief pastes pins, event ids, artifacts, gates" \
  round::tests::review_commits_b_before_the_review_worktree_and_pastes_pinned_reports \
  round::tests::fence_is_longer_than_any_inner_run
live "round review on the live project; reviewer produces C and V" live_review
row_end 5 "ha round review: brief commit B precedes review worktree; verdict V; ha done --sha V"

row_begin
det "stop after merged shows V, resume commits H, second merge is a no-op" \
  round::tests::stop_after_merged_shows_v_then_resume_commits_h \
  round::tests::merge_to_h_then_second_merge_is_a_noop \
  round::tests::a_dirty_lane_worktree_is_not_forwarded
det "item 34: crashes at ref, before H and after H recover without a second merge" \
  round::tests::crash_with_the_ref_still_at_b_retries_under_the_lock \
  round::tests::crash_between_ref_update_and_merged_is_recorded_without_a_second_merge \
  round::tests::item34_crash_before_h_resumes_from_the_recorded_intent \
  round::tests::item34_crash_after_h_before_marker_repairs_without_a_new_commit \
  round::tests::item34_a_descendant_that_is_not_h_fails_closed \
  round::tests::item34_a_ref_elsewhere_at_intent_is_merge_diverged
det "item 33: a removed or stale manifest fails closed" \
  round::tests::item33_manifest_removed_review_fails_closed \
  round::tests::item33_member_added_after_b_makes_merge_stale
det "D9 commit mechanics under the repository lock" \
  round::tests::unchecked_out_branch_uses_update_ref_with_the_expected_old_value \
  round::tests::the_repository_lock_is_exclusive
mod "item 32: helper death after staging is sealed by the ticker, a changed sha supersedes" A2 "ops::tests::(item_32|dead_helper)"
row_end 6 "ha round merge stop after merged; resume to H; item 32-34 fixtures"

row_begin
mod "ha done with a dirty tree, a wrong sha, an unstable report" A2 "ops::tests::done_refuses_(dirty|report)"
det "round review with an admitted lane not done" \
  round::tests::review_refuses_an_admitted_lane_without_a_sealed_done
det "merge: MERGE-AFTER-DECISION, moved head, earlier round, parent not C, C..V touches code, lane not in C" \
  round::tests::merge_refuses_each_bad_verdict_on_its_own_fixture \
  round::tests::b_not_an_ancestor_of_c_is_refused
row_end 7 "negative rows: dirty done, wrong sha, unstable report, incomplete review, stale merge verdicts"

row_begin
det "dialogue: pinned turns, Pro recipient check, turn commit" \
  dialogue::tests::start_needs_a_born_name_and_passes_the_pair_filter \
  dialogue::tests::a_pro_critic_must_be_the_chatgpt_agent_named_pro \
  dialogue::tests::a_turn_is_pinned_before_the_line_is_sent \
  dialogue::tests::commit_refuses_a_wrong_missing_or_empty_turn_then_commits_and_advances
live "pro-mcp start, passive adopt, one TURN, one artifact event, dialogue commit" live_pro
row_end 8 "pro-mcp start, passive adopt, one TURN, one artifact event, ha dialogue commit"

row_begin
live "claude as a lane, receipt observed" live_kind_claude
live "cursor as a lane, receipt observed" live_kind_cursor
live "codex, opencode, agy, dsh: capability unqualified" live_kind_other optional
mod "adapter table and capability labels" A2 "adapters::"
det "talk header labels per kind" talk::tests::header_labels_follow_the_coordinator_kind
row_end 9 "kind rows: claude and cursor required; others NOT-RUN when unavailable"

row_begin
det "the checker: R1 to R7 and the adversarial fixtures" \
  plain::tests::adversarial_bisimulation_fails_r4 \
  plain::tests::adversarial_choose_quotient_fails_r4_and_r6 \
  plain::tests::adversarial_definition_then_bare_use_fails_r1 \
  plain::tests::adversarial_registered_acronym_bare_fails_r1 \
  plain::tests::r1_pass_gloss_form_and_fail_bare_name \
  plain::tests::r7_pass_complete_say_and_fail_empty_what
det "ask records first, compact line at most 60, notification; stale revision refused" \
  ask::tests::a_term_as_a_choice_is_refused_and_nothing_is_recorded \
  ask::tests::ask_records_first_then_board_line_notification_and_surface \
  ask::tests::a_crash_after_the_record_is_resumed_by_the_ticker \
  ask::tests::answers_bind_id_and_revision
det "board: a failing value is not published, the old one stays; stage and lanes carry no name" \
  ask::tests::board_refuses_a_failing_value_and_keeps_the_old_one \
  ask::tests::board_templates_pass_the_check_and_carry_no_registry_name
det "talk: journal, frozen ask binding, replay sends nothing, unchecked say not appended" \
  talk::tests::a_digit_answers_the_frozen_binding_and_a_redrawn_ask_refuses_it \
  talk::tests::replay_is_identical_and_sends_nothing \
  talk::tests::an_unchecked_say_is_not_appended \
  talk::tests::a_cut_tail_is_skipped_terminated_and_reported_once
det "GLOSSARY.md and names at birth" ask::tests::names_are_born_with_a_sentence_and_listed_in_the_glossary
cli "ha ask with a term as a choice is refused" fail plain_question_form -- \
  "$HA" ask --project cli "F-cap criterion?" --choice "F-cap" --choice "no"
cli "ha ask writes its record first (publication needs herdr)" ok "ask a-1 revision 1" -- \
  "$HA" ask --project cli "keep the experiment running another hour, or stop now?" \
  --choice "keep it running another hour" --choice "stop it now"
cli "the record exists" ok "" -- test -f "$HERDR_ADE_ROOT/cli/asks/a-1/r1.toml"
cli "ha ask answer with a stale revision is refused" fail ask_revision_stale -- \
  "$HA" ask answer a-1 --revision 2 1 --project cli
cli "term add without --plain is refused" fail plain_missing -- \
  "$HA" term add quotient --project cli
cli "board values print and pass the check" ok "ade_stage" -- "$HA" board cli --print
mod "thread start without --plain refused; brief header plain:, no RULES.md" A1 "(threads|thread)::[a-z_:]*plain"
mod "the correction hook: rewrite on R1, budget, fixed notice, install and removal" A2 "hook::"
live "hook rewrite captured before, during and after; talk never shows the bare text" live_plain_hook
live "board tokens read back from the live workspace" live_board_readback
row_end 10 "plain-language rows: --plain, hook rewrite, talk captures, ha ask, board tokens, GLOSSARY.md"

row_begin
live "throwaway server stop; ha doctor reports unreachable; records intact" live_stop
row_end 11 "throwaway server stop; ha doctor reports unreachable; records intact"

# ------------------------------------------------------------- pi rows (SPEC-pi v2 §7)
# All under the throwaway root: setup installs the pinned pi into
# $HERDR_ADE_ROOT/pi and never links ~/.local/bin/pi (that line is Rolf's).

PI_LOGIN_REASON="no provider login in a throwaway; /login is Rolf's install-day step"
PI_JS="$HERDR_ADE_ROOT/pi/npm/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js"

pi_doctor_install_day_only() { # every failing row is a login or the ~/.local/bin/pi link
  out=$("$HP" doctor 2>&1)
  printf '%s\n' "$out" | grep -q '^\[ok  \] pin: 0.85.1' || { echo "no pin row at 0.85.1"; return 1; }
  bad=$(printf '%s\n' "$out" | grep '^\[FAIL\]' | grep -v 'missing login' | grep -v 'wrapper on PATH')
  [ -z "$bad" ] || { echo "$bad"; return 1; }
}

pi_no_global_package() {
  groot=$(zsh -lic 'npm root -g' 2>/dev/null | tail -1)
  [ -n "$groot" ] && [ ! -e "$groot/@earendil-works/pi-coding-agent" ]
}

pi_guard() {
  [ -f "$PI_JS" ] || { echo "no pinned pi at $PI_JS"; return 1; }
  ROOT="$ACC_DIR/guard" PI_JS="$PI_JS" sh "$checkout/src/pi/testdata/guard-check.sh" | tail -1 | grep -q '^GUARD PASS'
}

pi_mock_lane() {
  echo "NOT-RUN: a kind pi lane starts \`pi\` from the login PATH, which needs the ~/.local/bin/pi link (install day)"
}

row_begin
cli "herdr-pi setup installs the pin into the throwaway root" ok "0.85.1" -- "$HP" setup
cli "doctor: only the logins and the install-day PATH link fail" ok "" -- pi_doctor_install_day_only
row_end pi-T1 "herdr-pi doctor: pin 0.85.1, pi: current, prefix isolated, trust never"

row_begin
mod "check refuses a missing guard, extension, trust, wrapper or login" A5 "pi::doctor::tests::(a_caret|a_missing_login|a_good_install|check_report|login_shell)|pi::scenarios::scenario_check"
row_end pi-T2 "herdr-pi check refuses: guard, herdr extension, trust, wrapper, provider"

row_begin
live "mock lane in a repo with .pi/extensions: no trust question, repo extension did not run" pi_mock_lane
row_end pi-T3 "mock pi lane: no trust question, kind pi idle at prompt"

row_begin
cli "the guard turns 429, 401 and a context error into one WAITING each, never done" ok "" -- pi_guard
row_end pi-T7 "guard: mock 429 and 401 give blocked plus one WAITING, no done"

row_begin
cli "npm root -g does not hold the package" ok "" -- pi_no_global_package
mod "npm argv is pinned, never global" A5 "pi::install::tests::npm_argv|pi::doctor::tests::a_global_install"
row_end pi-T9 "no global npm install of pi"

row_begin
mod "a wrong pi earlier on PATH fails doctor and refuses the start" A5 "pi::doctor::tests::login_shell_chatter|pi::launch::tests::the_wrapper"
row_end pi-T10 "wrong pi earlier on PATH: doctor fails and start refuses"

row_begin
cli "check refuses and names the missing login" fail "credentials_not_configured" -- "$HP" check deepseek
mod "a missing login refuses the start" A5 "pi::scenarios::scenario_check_refuses_a_missing_login|pi::doctor::tests::a_missing_login"
row_end pi-T11 "missing login: the start is refused, never a lane waiting for its first prompt"

row_begin
cli "--provider cursor is refused" fail "pi_cursor_forbidden" -- "$HP" check cursor
mod "no Cursor route in pi" A5 "pi::doctor::tests::(check_refuses_cursor|a_cursor_package)|pi::launch::tests::forbidden_flags_and_cursor|pi::roles::tests::there_is_no_cursor"
row_end pi-T13 "no Cursor route: --provider cursor refused"

for r in "pi-T4 one live lane per enabled provider" "pi-T5 ha done from a pi lane" \
  "pi-T6a live handoff keeps the pi pid" "pi-T6b cold restore through ~/.local/bin/pi" \
  "pi-T8 after r2: exactly one --session" "pi-T12 two lanes on one OAuth provider" \
  "pi-T14 Pro pane restore after r2's args replay"; do
  # Optional rows: shown, never counted toward REQUIRED.
  printf 'NOT-RUN%s%s%s%s\n  NOT-RUN%slive%s%s (%s)\n' "$TAB" "${r%% *}" "$TAB" "${r#* }" \
    "$TAB" "$TAB" "${r#* }" "$PI_LOGIN_REASON"
done

# A server this script started is never left running.
if [ -f "$ACC_DIR/server.pid" ]; then
  H session stop "$ACC_SESSION" >/dev/null 2>&1 || true
fi

echo
if [ "$rows_pass" -eq "$rows_total" ]; then
  printf 'REQUIRED%sPASS%s%s/%s pass\n' "$TAB" "$TAB" "$rows_pass" "$rows_total"
  exit 0
fi
printf 'REQUIRED%sFAIL%s%s/%s pass\n' "$TAB" "$TAB" "$rows_pass" "$rows_total"
exit 1
